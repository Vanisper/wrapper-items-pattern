{
  "name": "@wrapper-items/vue",
  "version": "0.0.0",
  "description": "Vue composables for wrapper-items collection and order primitives",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsdown",
    "pretest": "pnpm --filter @wrapper-items/core build",
    "test": "vitest run src",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "@wrapper-items/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "catalog:vue"
  },
  "devDependencies": {
    "tsdown": "catalog:dev",
    "vitest": "catalog:dev",
    "vue": "catalog:vue"
  }
}
