{
  "name": "@wrapper-items/lib",
  "version": "0.0.0",
  "description": "Shared headless utilities for wrapper-items patterns",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run src",
    "dev": "tsdown --watch"
  },
  "devDependencies": {
    "tsdown": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
